# MongoDB connection string (local mongod or MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learning_platform?appName=Cluster0

# Port the API server listens on
PORT=5000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI API key used for the course-recommendation feature.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional fallback provider — used automatically if OpenAI isn't configured,
# or if an OpenAI request fails for any reason (bad key, quota, outage).
# Free key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# If NEITHER key above is a real value, /api/recommendations responds with
# 503 instead of crashing.

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Shared secret instructors must provide to register with the instructor role.
# Never sent to the frontend, never stored on the User document — validated
# server-side only.
INSTRUCTOR_REGISTRATION_CODE=replace_with_a_long_random_string
