# MongoDB connection string (local mongod or MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learning_platform?appName=Cluster0

# Port the API server listens on
PORT=5000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI API key used for the course-recommendation feature
# Without a real key, /api/recommendations responds with 503 instead of crashing.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173
